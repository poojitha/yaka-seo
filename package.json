{
  "name": "screamingai",
  "version": "0.1.0",
  "description": "Desktop SEO crawler built with Electron, Crawlee and Playwright",
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/electron-vite.cjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.cjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "crawlee": "^3.18.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
