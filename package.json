{
  "name": "screamingai",
  "version": "0.1.0",
  "description": "Desktop SEO crawler built with Electron, Crawlee and Playwright",
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/electron-vite.cjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.cjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project main --project renderer",
    "test:e2e": "vitest run --project e2e",
    "testsite": "node scripts/testsite.cjs",
    "test:watch": "vitest",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "crawlee": "^3.18.1",
    "lucide-react": "^1.49.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
